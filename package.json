{
    "name": "army-env-compliance",
    "version": "0.1.0",
    "description": "Army Environmental Compliance (x_cog_env): EPAS assessments, findings, corrective actions, regulatory enforcement actions and a Vantage data product, authored with the ServiceNow SDK / Fluent. Demo only, synthetic data.",
    "license": "UNLICENSED",
    "private": true,
    "type": "module",
    "imports": {
        "#now:*": "./@types/servicenow/fluent/*/index.js"
    },
    "scripts": {
        "build": "now-sdk build",
        "deploy": "now-sdk build && now-sdk install",
        "transform": "now-sdk transform",
        "types": "now-sdk dependencies",
        "lint": "eslint . && tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "seed": "tsx tools/seed.ts",
        "seed:users": "tsx tools/seed-demo-users.ts",
        "gen:sample-data": "tsx tools/generate-sample-data.ts",
        "gen:security": "tsx tools/generate-fluent-security.ts"
    },
    "devDependencies": {
        "@servicenow/glide": "27.0.5",
        "@servicenow/sdk": "4.12.1",
        "@types/node": "24.13.4",
        "csv-parse": "7.0.2",
        "eslint": "10.10.0",
        "tsx": "4.23.13",
        "typescript": "5.9.3",
        "typescript-eslint": "8.70.0",
        "vitest": "4.1.11"
    },
    "engines": {
        "node": ">=20"
    }
}
